
# directorio upload
upload/

# Caché de Python
__pycache__/
*.pyc

# Archivos SQLite
*.sqlite

# Archivos temporales de SQLite
*.sqlite-shm
*.sqlite-wal

# Logs de sistema y pruebas
log/
logs/
*.log

# Archivos de salida de datos (Excel / ODS)
out/
*.xlsx
*.ods
.~lock.*

# Archivos de configuración locales duplicados con fecha
*_2026[0-9]*
# ...pero no los tests con fecha en el nombre: convención establecida del proyecto
# (test_nav_discovery_freeze_20260915.py y hermanos, ya trackeados antes de esta regla;
# la regla de arriba los ocultaba en silencio para cualquier fichero NUEVO con ese patrón --
# encontrado 2026-09-27 al no aparecer test_nav_discovery_cli_isin_split_20260927.py en git status).
!test_*_2026[0-9]*.py

# IDE local (VSCode workspace state, machine-specific)
.vscode/
scripts/launch/180

# Local environment file (backend switch, DSNs) — loaded by shared/config.py; never commit
.env

# Local credentials scratch file (FND-0079: was untracked and NOT ignored) - never commit
passwords.txt

# P3 point-in-time backtest parquet cache (regenerable)
proyecto3/cache/
