# Environment variables read by this repo's Python code. Copy to `.env` (gitignored — never commit
# a real one) or set these in your shell / systemd unit / CI secrets. Passwords go via PGPASSWORD or
# a .pgpass file, never inline in a DSN.
#
# `.env` IS loaded automatically (shared/config.py, at import) — so ONE file decides the backend for
# every Python entry point, including steps started from the scripts/launch/*.bat launchers (which set
# no backend themselves). Precedence, highest first: an explicit --backend flag, a real environment
# variable, the `.env` file, the default (sqlite). Format: plain KEY=VALUE lines; `#` starts a comment
# only at the beginning of a line (no inline comments, no `export`). Use FONDOS_ENV_FILE to point at a
# different file. It is NOT loaded under pytest, so a developer's `.env` can never redirect tests.
# Every process prints one line saying what it connected to: `[DB] backend=postgres (env) host=...`.

# --- P1/P2/P3 operational database: PostgreSQL 17 (SQLite retired 2026-09-26, FND-0102) ---
# Backend switch (shared/config.py). Omitted = "postgres" (the default since the SQLite retirement);
# "sqlite" only exists for the transition and must be requested explicitly.
FONDOS_DB_BACKEND=postgres
# Required (shared/db.py). Points at the `fondos` database on the live server (127.0.0.1:5436, see
# AGENTS.md Context) — NOT the same DB as the backlog below.
# FONDOS_PG_DSN=postgresql://fondos_app@127.0.0.1:5436/fondos
# Pipelines run as the least-privilege `fondos_app` role (DML only, no DDL/CREATE, CONNECTION LIMIT 4; FND-0072).
# Seeds, migrations and DDL need the owner role: keep its DSN in FONDOS_PG_DSN_OWNER and override
# FONDOS_PG_DSN with it for that one command. Runtime code must never issue DDL (even IF NOT EXISTS needs ownership).
# FONDOS_PG_DSN_OWNER=postgresql://fondos_owner@localhost:5432/fondos

# --- Postgres test fixtures (shared/testing/pg_fixtures.py) ---
# Point at any local/CI Postgres 15+ instance to run the Postgres-backed test suite. Unset ->
# those tests skip cleanly; the SQLite-only suite is unaffected.
# FONDOS_TEST_PG_DSN=postgresql://postgres@localhost:5432/fondos_test

# --- Action-Points Backlog (shared/backlog_client.py, Fase 3, 2026-09-21) ---
# A DIFFERENT database on the same Postgres server as FONDOS_PG_DSN: `gestion`, schema `backlog`
# (db/pg_backlog/). Unset -> report_incident()/capture_exceptions() are a silent (INFO-logged)
# no-op; every pipeline entry point behaves exactly as it does today. Verify connectivity/
# permissions without writing anything: `python -m shared.backlog_client --check-dsn`.
# FONDOS_BACKLOG_PG_DSN=postgresql://postgres@localhost:5432/gestion
# Optional override for the local fallback log written when a Postgres incident-write fails
# (default: <repo_root>/log/backlog_autolog_fallback.jsonl).
# FONDOS_BACKLOG_FALLBACK_LOG=C:\desarrollo\fondos\log\backlog_autolog_fallback.jsonl

# --- Shared Postgres password (shared/db.py, pg_fixtures.py, backlog_client.py) ---
# PGPASSWORD=

# --- P2 macro data discovery (proyecto2/src/discovery/macro_discovery.py) ---
# FRED_API_KEY=

# --- Postgres migration scripts (scripts/mig/pg_seed.py, pg_reconcile.py) ---
# FONDOS_SQLITE_PATH=C:\desarrollo\fondos\db\fondos.sqlite
