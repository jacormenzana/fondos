{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jacormenzana/fondos/scripts/ops/open_pr_request.schema.json",
  "title": "open_pr request, version 1 (agent -> runner)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "branch", "ticket", "title", "body"],
  "properties": {
    "v": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "branch": {"type": "string", "pattern": "^(?!-)(?!.*\\.\\.)(?!.*//)(?!.*\\.lock$)(?!.*@\\{)[A-Za-z0-9._/-]{1,100}$"},
    "ticket": {"type": "string", "pattern": "^FND-[0-9]{4}$"},
    "title": {"type": "string", "pattern": "^[A-Za-z0-9 .,:()/_#+'-]{1,200}$"},
    "body": {"type": "string", "maxLength": 20000, "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"}
  }
}
