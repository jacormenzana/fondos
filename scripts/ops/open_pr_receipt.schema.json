{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jacormenzana/fondos/scripts/ops/open_pr_receipt.schema.json",
  "title": "open_pr receipt, version 1 (runner -> agent)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "request_id", "status", "pr_number", "pr_url", "head_sha", "base", "opened_at"],
      "properties": {
        "v": {"type": "integer", "const": 1},
        "request_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "status": {"type": "string", "const": "PR_OPENED"},
        "pr_number": {"type": "integer", "minimum": 1},
        "pr_url": {"type": "string", "pattern": "^https://github\\.com/jacormenzana/fondos/pull/[0-9]+$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base": {"type": "string", "const": "master"},
        "opened_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "request_id", "status", "reason"],
      "properties": {
        "v": {"type": "integer", "const": 1},
        "request_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "status": {"type": "string", "enum": ["REFUSED", "REJECTED_SECURITY", "FAILED"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"}
      }
    }
  ]
}
