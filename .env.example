# Environment variables read by this repo's Python code. Copy to `.env` (or set these in your
# shell / systemd unit / CI secrets) — never commit a real `.env` file. Passwords go via
# PGPASSWORD or a .pgpass file, never inline in a DSN.

# --- P1/P2/P3 operational database (SQLite by default; Postgres migration in progress) ---
# Backend switch (shared/config.py). Omit or "sqlite" = no behavior change (current default).
FONDOS_DB_BACKEND=sqlite
# Required only when FONDOS_DB_BACKEND=postgres (shared/db.py). Points at the `fondos` database
# on the P1/P2/P3 migration target (db/pg/, docker/) — NOT the same server/DB as the backlog below.
# FONDOS_PG_DSN=postgresql://fondos_app@localhost:5432/fondos

# --- Postgres test fixtures (shared/testing/pg_fixtures.py) ---
# Point at any local/CI Postgres 15+ instance to run the Postgres-backed test suite. Unset ->
# those tests skip cleanly; the SQLite-only suite is unaffected.
# FONDOS_TEST_PG_DSN=postgresql://postgres@localhost:5432/fondos_test

# --- Action-Points Backlog (shared/backlog_client.py, Fase 3, 2026-09-21) ---
# A DIFFERENT database on the same Postgres server as FONDOS_PG_DSN: `gestion`, schema `backlog`
# (db/pg_backlog/). Unset -> report_incident()/capture_exceptions() are a silent (INFO-logged)
# no-op; every pipeline entry point behaves exactly as it does today. Verify connectivity/
# permissions without writing anything: `python -m shared.backlog_client --check-dsn`.
# FONDOS_BACKLOG_PG_DSN=postgresql://postgres@localhost:5432/gestion
# Optional override for the local fallback log written when a Postgres incident-write fails
# (default: <repo_root>/log/backlog_autolog_fallback.jsonl).
# FONDOS_BACKLOG_FALLBACK_LOG=C:\desarrollo\fondos\log\backlog_autolog_fallback.jsonl

# --- Shared Postgres password (shared/db.py, pg_fixtures.py, backlog_client.py) ---
# PGPASSWORD=

# --- P2 macro data discovery (proyecto2/src/discovery/macro_discovery.py) ---
# FRED_API_KEY=

# --- Postgres migration scripts (scripts/mig/pg_seed.py, pg_reconcile.py) ---
# FONDOS_SQLITE_PATH=C:\desarrollo\fondos\db\fondos.sqlite
